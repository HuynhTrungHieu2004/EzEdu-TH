@startuml
title EzEdu AI – Use Case tổng thể
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Khách" as Guest
actor "Học sinh" as Student
actor "Giảng viên" as Lecturer
actor "Nhân sự quản trị" as Staff
actor "Quản trị viên" as Admin
actor "Super Admin" as Super
actor "Dịch vụ AI\nGemini/Groq" as AI
actor "Cloudinary" as Cloud
actor "Nguồn web" as Web

rectangle "EzEdu AI" {
  package "Tài khoản & truy cập" {
    usecase "Đăng ký / đăng nhập" as UC01
    usecase "Quản lý hồ sơ" as UC02
    usecase "Phân quyền RBAC" as UC03
  }
  package "Học liệu & RAG" {
    usecase "Tải và quản lý tài liệu" as UC04
    usecase "Trích xuất, chia đoạn,\nembedding & lập chỉ mục" as UC05
    usecase "Xác minh chất lượng tài liệu" as UC06
    usecase "Hỏi đáp theo tài liệu / web" as UC07
  }
  package "Luyện tập & kiểm tra" {
    usecase "Sinh bộ câu hỏi" as UC08
    usecase "Làm bài luyện tập" as UC09
    usecase "Quản lý ngân hàng câu hỏi" as UC10
    usecase "Tạo blueprint và đề thi" as UC11
    usecase "Thi có thời gian & chấm điểm" as UC12
  }
  package "Dạy học & cá nhân hóa" {
    usecase "Quản lý lớp học" as UC13
    usecase "Theo dõi tiến độ" as UC14
    usecase "Quản lý knowledge graph" as UC15
    usecase "Đề xuất lộ trình học" as UC16
  }
  package "Quản trị & vận hành" {
    usecase "Quản trị người dùng / nội dung" as UC17
    usecase "Kiểm duyệt nguồn tri thức" as UC18
    usecase "Cấu hình, feature flag" as UC19
    usecase "Giám sát AI, job, audit" as UC20
  }
}

Guest --> UC01
Student --> UC02
Student --> UC04
Student --> UC07
Student --> UC09
Student --> UC12
Student --> UC14
Student --> UC16
Lecturer --> UC02
Lecturer --> UC04
Lecturer --> UC06
Lecturer --> UC08
Lecturer --> UC10
Lecturer --> UC11
Lecturer --> UC13
Lecturer --> UC14
Staff --> UC17
Staff --> UC18
Admin --> UC03
Admin --> UC17
Admin --> UC19
Admin --> UC20
Super --> UC03
Super --> UC19
Super --> UC20

UC04 .> UC05 : <<include>>
UC06 .> UC05 : <<include>>
UC07 .> UC05 : <<include>>
UC08 .> UC05 : <<include>>
UC11 .> UC10 : <<include>>
UC12 .> UC11 : <<include>>
UC16 .> UC14 : <<include>>

AI --> UC05
AI --> UC06
AI --> UC07
AI --> UC08
Cloud --> UC04
Web --> UC07
Web --> UC18
@enduml

