PROJECT_NAME="FastAPI Learning Assessment System"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MongoDB Atlas configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="learning_assessment"

# JWT Authentication Configuration
JWT_SECRET_KEY="your_super_secret_key_minimum_32_characters_long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
CREATE_DEFAULT_TEST_USER=false

# Cloudinary Integration Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Groq API Key (dual-AI cross-check and video transcription)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Personalization feature flags (off until implemented)
PERSONALIZATION_ENABLED=false
KNOWLEDGE_GRAPH_ENABLED=false
LEARNER_MODEL_ENABLED=false
RECOMMENDATION_ENABLED=false
AI_RECOMMENDATION_EXPLANATION_ENABLED=false
BANDIT_ENABLED=false
NEURALCD_ENABLED=false
AKT_ENABLED=false
BANDIT_SHADOW_MODE_ENABLED=false
BANDIT_KILL_SWITCH=true
BANDIT_CONTEXT_SCHEMA_VERSION="bandit-context-v1"
BANDIT_EXPLORATION_RATE=0.05
BANDIT_MAX_EXPLORATION_RATE=0.10
BANDIT_PRIOR_PRECISION=1.0
BANDIT_PRIOR_MEAN=0.0
BANDIT_REWARD_LEARNING_WEIGHT=0.6
BANDIT_REWARD_IMMEDIATE_WEIGHT=0.4

# Personalization model/version metadata
FEATURE_SCHEMA_VERSION="v1"
KNOWLEDGE_MODEL_VERSION="v0"
LEARNER_MODEL_VERSION="v0"
CLUSTERING_MODEL_VERSION="v0"
RANKING_MODEL_VERSION="v0"
BANDIT_POLICY_VERSION="v0"
NEURALCD_MODEL_VERSION="v0-research"
AKT_MODEL_VERSION="v0-research"
ADVANCED_MODEL_MIN_USERS=100
ADVANCED_MODEL_MIN_ITEMS=300
ADVANCED_MODEL_MIN_INTERACTIONS=5000
ADVANCED_MODEL_MIN_INTERACTIONS_PER_USER=20.0
ADVANCED_MODEL_MIN_KNOWLEDGE_COMPONENTS=20
ADVANCED_MODEL_MIN_Q_MATRIX_COVERAGE=0.8
ADVANCED_MODEL_MAX_SPARSITY=0.98
ADVANCED_MODEL_MIN_SEQUENCE_LENGTH=10
MAX_KNOWLEDGE_COMPONENTS_PER_ITEM=4
KNOWLEDGE_EXTRACTION_LOW_CONFIDENCE_THRESHOLD=0.65
KNOWLEDGE_COMPONENT_MERGE_SIMILARITY_THRESHOLD=0.92
BKT_DEFAULT_P_INIT=0.25
BKT_DEFAULT_P_LEARN=0.12
BKT_DEFAULT_P_GUESS=0.2
BKT_DEFAULT_P_SLIP=0.1
BKT_MIN_PROBABILITY=0.001
BKT_MAX_PROBABILITY=0.999
IRT_LEARNING_RATE=0.08
IRT_MIN_THETA=-4.0
IRT_MAX_THETA=4.0
IRT_MIN_BETA=-4.0
IRT_MAX_BETA=4.0
IRT_MIN_ATTEMPTS_RELIABLE=5
KMEANS_MIN_K=2
KMEANS_MAX_K=8
KMEANS_MIN_CLUSTER_SIZE=2
KMEANS_MIN_SAMPLES=8
KMEANS_RANDOM_STATE=42
KMEANS_N_INIT=10
KMEANS_MAX_ITER=300
KMEANS_EMBEDDING_WEIGHT=0.7
KMEANS_NUMERIC_WEIGHT=0.3
KMEANS_OUTLIER_DISTANCE_STD_MULTIPLIER=2.5
DIGITAL_TWIN_CACHE_TTL_SECONDS=60
DIGITAL_TWIN_STRENGTH_MASTERY_THRESHOLD=0.75
DIGITAL_TWIN_WEAK_MASTERY_THRESHOLD=0.45
DIGITAL_TWIN_UNCERTAINTY_THRESHOLD=0.55
DIGITAL_TWIN_MIN_ATTEMPTS_ASSESSED=3
DIGITAL_TWIN_FORGETTING_RISK_DAYS=14
DIGITAL_TWIN_FORGETTING_RISK_THRESHOLD=0.65
DIGITAL_TWIN_TARGET_PROBABILITY_MIN=0.6
DIGITAL_TWIN_TARGET_PROBABILITY_MAX=0.8
CANDIDATE_PER_SOURCE_LIMIT=5
CANDIDATE_TOTAL_LIMIT=30
CANDIDATE_MIN_QUALITY_SCORE=0.5
CANDIDATE_RECENT_WINDOW_HOURS=24
CANDIDATE_EXPLORATION_RATIO=0.1
CANDIDATE_APPROPRIATE_DIFFICULTY_MARGIN=0.15
CANDIDATE_FORGETTING_MIN_MASTERY=0.65
RANKER_WEIGHT_WEAKNESS_MATCH=0.25
RANKER_WEIGHT_DIFFICULTY_FIT=0.20
RANKER_WEIGHT_PREREQUISITE_READINESS=0.15
RANKER_WEIGHT_FORGETTING_NEED=0.15
RANKER_WEIGHT_GOAL_MATCH=0.10
RANKER_WEIGHT_INTEREST_MATCH=0.05
RANKER_WEIGHT_CLUSTER_MATCH=0.0
RANKER_WEIGHT_QUALITY_SCORE=0.10
RANKER_WEIGHT_NOVELTY_SCORE=0.0
RANKER_WEIGHT_CONTINUITY_SCORE=0.0
RANKER_SAFE_DIFFICULTY_MARGIN=0.25
RERANK_MAX_SAME_KNOWLEDGE_COMPONENT=2
RERANK_MAX_SAME_QUESTION_CLUSTER=2
RERANK_MAX_SAME_ITEM_TYPE=2
RECOMMENDATION_CACHE_TTL_SECONDS=60

# ── ChromaDB (kho vector) ──
# persistent: đọc/ghi thẳng thư mục cục bộ, không cần dựng thêm dịch vụ.
#   Chỉ đúng khi backend chạy MỘT tiến trình duy nhất.
# http: nối tới Chroma server dùng chung. BẮT BUỘC khi chạy nhiều worker
#   (uvicorn --workers N) hoặc nhiều máy chủ — nếu không, các tiến trình sẽ
#   không thấy dữ liệu vector của nhau.
#   Dựng server: chroma run --path ./chroma_db --host 0.0.0.0 --port 8001
CHROMA_MODE=persistent
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_AUTH_TOKEN=
