VITE_API_BASE_URL="https://your-backend-url"

# Đăng nhập Google: OAuth Client ID lấy từ Google Cloud Console (không phải bí
# mật — chỉ định danh ứng dụng, an toàn khi lộ ra frontend). Thiếu biến này
# thì nút đăng nhập Google báo "Chưa cấu hình đăng nhập Google".
VITE_GOOGLE_CLIENT_ID=

# Đăng nhập Facebook: App ID lấy từ developers.facebook.com (không phải bí
# mật — nằm công khai trong mã frontend). App Secret KHÔNG bao giờ đặt ở đây,
# nó chỉ nằm ở biến môi trường của backend.
VITE_FACEBOOK_APP_ID=
# Để trống thì dùng v21.0. Đổi khi Facebook khoá phiên bản cũ; số đúng xem ở
# App Dashboard, phải khớp FACEBOOK_GRAPH_VERSION bên backend.
VITE_FACEBOOK_GRAPH_VERSION=
